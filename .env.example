# ==============================================================================
# Configuracoes de Ambiente - Self-Correcting RAG & Data Engineering Pipeline
# ==============================================================================

# Ollama Endpoint Local
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelos Locais (Ollama)
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q3_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Hiperparametros de Particionamento e Busca Vetorial
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_DOCUMENTS=4
MAX_RETRIES=3

# Logging & Debug
PYTHONUNBUFFERED=1

